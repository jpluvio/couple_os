// Prisma Schema — Couple OS
// Phase 0: Users, Couples, InviteCodes
// Phase 1.1: Posts, Reactions (Message Board)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatarUrl String?  @db.VarChar(500) @map("avatar_url")
  pushTokens String[] @default([]) @map("push_tokens")
  googleId  String   @unique @map("google_id")
  salary    Float?   @default(0)

  coupleId  String?  @map("couple_id")
  couple    Couple?  @relation(fields: [coupleId], references: [id])

  posts     Post[]
  reactions Reaction[]
  events    Event[]
  todoItems  TodoItem[]
  expenses   Expense[]    @relation("expenses")
  checkins1  CheckIn[]    @relation("checkins1")
  checkins2  CheckIn[]    @relation("checkins2")
  memories   Memory[]     @relation("memories")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Couple {
  id        String   @id @default(uuid())
  name      String?
  splitMode String   @default("EQUAL") @map("split_mode") // "EQUAL" or "PROPORTIONAL"

  members   User[]
  posts     Post[]
  events    Event[]
  todoLists TodoList[]
  pantryItems  PantryItem[]
  shoppingItems ShoppingItem[]
  recipes        Recipe[]
  expenses       Expense[]
  financialGoals FinancialGoal[]
  checkIns       CheckIn[]
  memories       Memory[]

  inviteCodes InviteCode[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("couples")
}

model InviteCode {
  id        String   @id @default(uuid())
  code      String   @unique
  used      Boolean  @default(false)

  coupleId  String   @map("couple_id")
  couple    Couple   @relation(fields: [coupleId], references: [id])

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("invite_codes")
}

// ---- Phase 1.1: Message Board ----

model Post {
  id        String   @id @default(uuid())
  content   String   @db.VarChar(500)
  pinned    Boolean  @default(false)
  tags      String[] @default([])

  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])

  coupleId  String   @map("couple_id")
  couple    Couple   @relation(fields: [coupleId], references: [id])

  reactions Reaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([coupleId, createdAt])
  @@map("posts")
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String   @db.VarChar(10)

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, postId, emoji])
  @@map("reactions")
}

// ---- Phase 1.2: Calendar ----

model Event {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(200)
  description String?  @db.Text
  location    String?  @db.VarChar(300)
  startAt     DateTime @map("start_at")
  endAt       DateTime @map("end_at")
  allDay      Boolean  @default(false) @map("all_day")
  color       String?  @db.VarChar(7)  // hex color e.g. #FF5733
  recurrence  String?  @db.VarChar(100) // RRULE string or null

  creatorId   String   @map("creator_id")
  creator     User     @relation(fields: [creatorId], references: [id])

  coupleId    String   @map("couple_id")
  couple      Couple   @relation(fields: [coupleId], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([coupleId, startAt])
  @@map("events")
}

// ---- Phase 1.3: To-Do Lists ----

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  DONE
}

model TodoList {
  id        String     @id @default(uuid())
  name      String     @db.VarChar(100)
  emoji     String?    @db.VarChar(10)

  coupleId  String     @map("couple_id")
  couple    Couple     @relation(fields: [coupleId], references: [id])

  items     TodoItem[]

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([coupleId])
  @@map("todo_lists")
}

model TodoItem {
  id          String     @id @default(uuid())
  title       String     @db.VarChar(300)
  description String?    @db.Text
  deadline    DateTime?
  priority    Priority   @default(MEDIUM)
  status      TodoStatus @default(TODO)

  assigneeId  String?    @map("assignee_id")
  assignee    User?      @relation(fields: [assigneeId], references: [id])

  listId      String     @map("list_id")
  list        TodoList   @relation(fields: [listId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([listId, status])
  @@map("todo_items")
}

// ---- Phase 2.1: Pantry & Shopping & Cook Book ----

enum PantryCategory {
  FRIDGE
  FREEZER
  PANTRY
  BATHROOM
  OTHER
}

model PantryItem {
  id        String         @id @default(uuid())
  name      String         @db.VarChar(200)
  category  PantryCategory @default(PANTRY)
  quantity  Int            @default(1)
  unit      String?        @db.VarChar(30)
  expiresAt DateTime?      @map("expires_at")

  coupleId  String         @map("couple_id")
  couple    Couple         @relation(fields: [coupleId], references: [id])

  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([coupleId, category])
  @@map("pantry_items")
}

model ShoppingItem {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(200)
  quantity  Int      @default(1)
  unit      String?  @db.VarChar(30)
  notes     String?  @db.VarChar(300)
  checked   Boolean  @default(false)

  coupleId  String   @map("couple_id")
  couple    Couple   @relation(fields: [coupleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([coupleId, checked])
  @@map("shopping_items")
}

model Recipe {
  id          String             @id @default(uuid())
  title       String             @db.VarChar(200)
  description String?            @db.Text
  servings    Int?

  coupleId    String             @map("couple_id")
  couple      Couple             @relation(fields: [coupleId], references: [id])

  ingredients RecipeIngredient[]

  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([coupleId])
  @@map("recipes")
}

model RecipeIngredient {
  id       String  @id @default(uuid())
  name     String  @db.VarChar(200)
  quantity String? @db.VarChar(50)

  recipeId String  @map("recipe_id")
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_ingredients")
}

// ---- Phase 2.2: Finance Tracker ----

model Expense {
  id        String   @id @default(uuid())
  amount    Float
  category  String   @db.VarChar(50)
  note      String?  @db.VarChar(300)
  date      DateTime @default(now())
  paidById  String   @map("paid_by_id")
  paidBy    User     @relation("expenses", fields: [paidById], references: [id])

  coupleId  String   @map("couple_id")
  couple    Couple   @relation(fields: [coupleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([coupleId, date])
  @@map("expenses")
}

model FinancialGoal {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(200)
  targetAmount Float   @map("target_amount")
  savedAmount  Float   @default(0) @map("saved_amount")

  coupleId    String   @map("couple_id")
  couple      Couple   @relation(fields: [coupleId], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([coupleId])
  @@map("financial_goals")
}

// ---- Phase 2.3: Check-in ----

model CheckIn {
  id         String   @id @default(uuid())
  prompt     String   @db.Text
  periodType String   @db.VarChar(20) @map("period_type") // weekly, monthly, yearly
  mood1      Int?     // partner 1 mood (1-5)
  response1  String?  @db.Text
  mood2      Int?     // partner 2 mood (1-5)
  response2  String?  @db.Text
  revealed   Boolean  @default(false) // both must answer before revealing

  user1Id    String?  @map("user1_id")
  user1      User?    @relation("checkins1", fields: [user1Id], references: [id])
  user2Id    String?  @map("user2_id")
  user2      User?    @relation("checkins2", fields: [user2Id], references: [id])

  coupleId   String   @map("couple_id")
  couple     Couple   @relation(fields: [coupleId], references: [id])

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([coupleId, createdAt])
  @@map("check_ins")
}

// ---- Phase 2.4: Memory Box ----

model Memory {
  id        String   @id @default(uuid())
  content   String   @db.Text
  tags      String[] @default([])
  photos    String[] @default([]) // URLs
  date      DateTime @default(now())

  authorId  String   @map("author_id")
  author    User     @relation("memories", fields: [authorId], references: [id])

  coupleId  String   @map("couple_id")
  couple    Couple   @relation(fields: [coupleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([coupleId, date])
  @@map("memories")
}
